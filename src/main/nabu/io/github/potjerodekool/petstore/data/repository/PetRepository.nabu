package io.github.potjerodekool.petstore.data.repository;

import io.github.potjerodekool.petstore.api.model.Status;
import io.github.potjerodekool.petstore.data.entity.Pet;

import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.repository.query.Param;
import org.springframework.data.jpa.repository.Query;
import java.util.UUID;
import java.util.List;

public interface PetRepository extends JpaRepository<Pet, UUID> {

    @Query(value = "FROM Pet p where p.status in (:statuses)")
    fun findByStatus(@Param(value = "statuses") statuses: List<Status>): List<Pet>;

    @Query(value = "FROM Pet p INNER JOIN p.tags t WHERE t.name in (:tags)")
    fun findByTags(@Param(value = "tags") tags: List<String>): List<Pet>;
}