package io.github.potjerodekool.petstore.data.entity;

import io.github.potjerodekool.petstore.api.model.Status;

import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.Id;
import jakarta.persistence.ManyToOne;
import jakarta.persistence.ElementCollection;
import java.util.UUID;
import java.util.Set;
import java.util.HashSet;

@Entity
public class Pet {
    @Id
    @GeneratedValue
    private id : UUID;

    private name : String;

    private status : Status;

    @ManyToOne
    private category : Category;

    @ElementCollection(targetClass = Tag.class)
    private tags: Set<Tag>;

    @ElementCollection(targetClass = String.class)
    private photoUrls: Set<String>;

    public fun getId(): UUID {
        return this.id;
    }

    public fun setId(id: UUID): void {
        this.id = id;
    }

    public fun getName(): String {
        return this.name;
    }

    public fun setName(name: String): void {
        this.name = name;
    }

    public fun getCategory() : Category {
        return this.category;
    }

    public fun setCategory(category: Category): void {
        this.category = category;
    }

    public fun getStatus(): Status {
        return this.status;
    }

    public fun setStatus(final status: Status): void {
        this.status = status;
    }

    public fun getTags(): Set<Tag> {
        return this.tags;
    }

    public fun setTags(tags: Set<Tag>): void {
        this.tags = tags;
    }

    public fun addPhotoUrl(final url: String): void {
         if (this.photoUrls == null) {
            this.photoUrls = new HashSet();
         }
         this.photoUrls.add(url);
    }
}
