package io.github.potjerodekool.petstore.api;

import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.bind.annotation.GetMapping;

import java.util.Map;
import java.util.HashMap;

@RestController
@RequestMapping(value = {"/store"})
public class StoreController {

    private final petService : PetService;

    public StoreController(final petService : PetService) {
        this.petService = petService;
    }

    @GetMapping(value = "/inventory")
    public fun getInventory(): Map<String, Integer> {
        final var pets = petService.findAll();
        final var map : Map<String, Integer> = new HashMap<String, Integer>();

        for (var pet in pets) {
            final var status : String = pet.getStatus().name();
            final var count = (Integer) map.getOrDefault(status, 0) + 1;
            map.put(status, count);
        }

        return map;
    }
}