package io.github.potjerodekool.petstore.api;

import io.github.potjerodekool.petstore.api.model.PetDto;
import io.github.potjerodekool.petstore.api.model.Status;

import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestParam;

import org.springframework.web.multipart.MultipartFile;

import jakarta.validation.Valid;

import java.util.UUID;
import java.util.List;

@RestController
@RequestMapping(value = {"/pet"})
public class PetController {

    private petService : PetService;

    public PetController(final petService : PetService) {
        this.petService = petService;
    }

    @PostMapping
    public fun createPet(@RequestBody final dto: PetDto) : void {
        petService.createPet(dto);
    }

    @PutMapping
    public fun updatePet(@RequestBody final dto: PetDto) : void {
        petService.updatePet(dto);
    }

    @GetMapping(value = {"/{petId}"})
    public fun getPetById(@PathVariable(value = "petId") petId: UUID): PetDto {
        return petService.getPetById(petId);
    }

    @GetMapping(value = {"/findByStatus"})
    public fun findByStatus(@RequestParam(value = "status") status: List<Status>): List<PetDto> {
        return petService.findByStatus(status);
    }

    @GetMapping(value = {"/findByTags"})
    public fun findByTags(@RequestParam(value = "tags") tags: List<String>): List<PetDto> {
        return petService.findByTags(tags);
    }

    @DeleteMapping(value = {"/{petId}"})
    public fun deleteById(@PathVariable(value = "petId") petId: UUID): void {
        petService.deleteById(petId);
    }

    @PostMapping(value = {"/{petId}/uploadImage"})
    public fun uploadImage(@PathVariable(value = "petId") petId: UUID,
            @RequestParam(value = "image") final file : MultipartFile): void {
        petService.uploadImage(petId, file);
    }

    @PostMapping(value = {"/{petId}"})
    public fun updatePetWithForm(@PathVariable(value = "petId") petId: UUID,
                    @Valid @RequestParam(value = "name", required = false) name : String,
                    @Valid @RequestParam(value = "status", required = false) status: Status): void {
       petService.updatePetWithForm(petId, name, status);
    }

}